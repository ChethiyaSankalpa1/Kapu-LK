# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Configuration
ADMIN_EMAIL=admin@matrimony.com
ADMIN_PASSWORD=admin123

# Frontend URL for password reset links & email redirection
CLIENT_URL=http://localhost:3000

# Brevo Transactional Email REST API Configuration (HTTPS port 443 - Render Free compatible)
BREVO_API_KEY=your_brevo_api_key_here
# EMAIL_FROM must be a verified sender in your Brevo account.
# WARNING: Do NOT use a @gmail.com address here - Gmail DMARC policy will silently reject
# emails sent from @gmail.com via third-party services like Brevo.
# Use the email address you verified inside Brevo → Senders & IPs → Senders.
EMAIL_FROM=your-verified-brevo-sender@example.com
EMAIL_FROM_NAME=Kapu-LK Support Team
RESET_CODE_EXPIRES_MINUTES=10
REQUIRE_EMAIL_VERIFICATION=true
